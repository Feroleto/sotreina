generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String?              @unique
  passwordHash        String?              @map("password_hash")
  firstName           String?              @map("first_name")
  profileImgUrl       String?              @map("profile_img_url")
  maxHr               Int?                 @map("max_hr")
  dailyKcalGoal       Int                  @default(2000) @map("daily_kcal_goal")
  dailyProteinGoal    Int                  @default(150) @map("daily_protein_goal")
  dailyCarbsGoal      Int                  @default(250) @map("daily_carbs_goal")
  dailyFatGoal        Int                  @default(65) @map("daily_fat_goal")
  weeklyRunKmGoal     Int                  @default(20) @map("weekly_run_km_goal")
  weeklyWorkoutsGoal  Int                  @default(3) @map("weekly_workouts_goal")
  // areas the user chose to use; empty = not chosen yet (new account, the
  // client shows the area picker). Existing users were backfilled with all three
  enabledAreas        Area[]               @default([]) @map("enabled_areas")
  tokenVersion        Int                  @default(0) @map("token_version")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activities          Activity[]
  stravaAccount       StravaAccount?
  gear                Gear[]
  athleteHrZones      AthleteHrZones?
  workouts            Workout[]
  createdExercises    Exercise[]
  workoutTemplates    WorkoutTemplate[]
  passwordResetTokens PasswordResetToken[]
  createdFoods        Food[]
  meals               Meal[]
  foodLogs            FoodLog[]
  savedMeals          SavedMeal[]

  @@map("users")
}

model StravaAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  stravaAthleteId BigInt   @unique
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("strava_accounts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Activity {
  id                  String               @id @default(cuid())
  userId              String
  stravaId            BigInt               @unique
  name                String
  type                String
  sportType           String?              @map("sport_type")
  workoutType         WorkoutType          @map("workout_type")
  startDate           DateTime             @map("start_date")
  distanceKm          Float?               @map("distance_km")
  movingTimeSec       Int                  @map("moving_time_sec")
  paceRawSecKm        Float?               @map("pace_raw_sec_km")
  elevationGainM      Float?               @map("elevation_gain_m")
  averageBpm          Float?               @map("average_bpm")
  maxBpm              Float?               @map("max_bpm")
  averageCadence      Float?               @map("average_cadence")
  summaryPolyline     String?              @map("summary_polyline")
  gearId              String?              @map("gear_id")
  bestEffortsSyncedAt DateTime?            @map("best_efforts_synced_at")
  hrZonesSyncedAt     DateTime?            @map("hr_zones_synced_at")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  gear                Gear?                @relation(fields: [gearId], references: [id], onDelete: SetNull)
  laps                ActivityLap[]
  seconds             ActivitySecond[]
  bestEfforts         ActivityBestEffort[]
  hrZoneTimes         ActivityHrZoneTime[]

  @@index([userId, startDate])
  @@map("activities")
}

model ActivitySecond {
  id             String   @id @default(cuid())
  activityId     String
  secondIndex    Int      @map("second_index")
  distanceTotalM Float    @map("distance_total_m")
  distanceDeltaM Float    @map("distance_delta_m")
  speedMS        Float?   @map("speed_m_s")
  paceSecKm      Float?   @map("pace_sec_km")
  elevationM     Float?   @map("elevation_m")
  heartRate      Int?     @map("heart_rate")
  cadence        Float?   @map("cadence")
  activity       Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, secondIndex])
  @@map("activity_seconds")
}

model ActivityLap {
  id                String   @id @default(cuid())
  activityId        String
  lapIndex          Int      @map("lap_index")
  lapType           LapType  @map("lap_type")
  startSec          Int      @map("start_sec")
  endSec            Int      @map("end_sec")
  totalDurationSec  Int      @map("total_duration_sec")
  movingDurationSec Int      @map("moving_duration_sec")
  distanceM         Float    @map("distance_m")
  avgPaceSecKm      Float    @map("avg_pace_sec_km")
  avgHr             Float    @map("avg_hr")
  maxHr             Float?   @map("max_hr")
  elevGainM         Float    @map("elev_gain_m")
  avgGradePercent   Float?   @map("avg_grade_percent")
  vam               Float?   @map("vam")
  avgCadence        Float?   @map("avg_cadence")
  activity          Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, lapIndex])
  @@index([activityId, lapType])
  @@map("activity_laps")
}

model Gear {
  id         String     @id
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  brandName  String?    @map("brand_name")
  modelName  String?    @map("model_name")
  distance   Int
  primary    Boolean    @default(false)
  retired    Boolean    @default(false)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  activities Activity[]

  @@index([userId])
  @@map("gears")
}

model ActivityBestEffort {
  id          String   @id
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name        String
  distance    Float
  movingTime  Int      @map("moving_time")
  elapsedTime Int      @map("elapsed_time")
  startDate   DateTime @map("start_date")
  prRank      Int?     @map("pr_rank")
  startIndex  Int?     @map("start_index")
  endIndex    Int?     @map("end_index")

  @@index([name, movingTime])
  @@index([activityId])
  @@map("activity_best_efforts")
}

model AthleteHrZones {
  id          String   @id @default(cuid())
  userId      String   @unique
  customZones Boolean  @map("custom_zones")
  zones       Json
  syncedAt    DateTime @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("athlete_hr_zones")
}

model ActivityHrZoneTime {
  id         String   @id @default(cuid())
  activityId String
  zoneIndex  Int      @map("zone_index")
  min        Int
  max        Int
  timeSec    Int      @map("time_sec")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, zoneIndex])
  @@map("activity_hr_zone_time")
}

enum Area {
  RUN
  GYM
  DIET
}

enum WorkoutType {
  EASY_OR_LONG
  INTERVAL
  HILL_REPEATS

  @@map("workout_type")
}

enum LapType {
  RUN
  WORKOUT
  REST
  STEADY
  WARMUP
  COOLDOWN
  ACTIVITY

  @@map("lap_type")
}

// ---- Gym module (strength training log) ----

enum ExerciseSource {
  SEED
  USER

  @@map("exercise_source")
}

enum MuscleGroup {
  CHEST
  BACK
  LATS
  TRAPS
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  ABDOMINALS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  ADDUCTORS
  ABDUCTORS
  LOWER_BACK
  NECK
  CARDIO
  FULL_BODY

  @@map("muscle_group")
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODY_ONLY
  KETTLEBELLS
  BANDS
  MEDICINE_BALL
  EXERCISE_BALL
  FOAM_ROLL
  EZ_CURL_BAR
  OTHER

  @@map("equipment")
}

enum ExerciseLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT

  @@map("exercise_level")
}

enum ExerciseForce {
  PUSH
  PULL
  STATIC

  @@map("exercise_force")
}

enum ExerciseMechanic {
  COMPOUND
  ISOLATION

  @@map("exercise_mechanic")
}

enum SetType {
  WARMUP
  WORKING
  DROPSET

  @@map("set_type")
}

model Exercise {
  id                String                    @id @default(cuid())
  name              String
  namePt            String?                   @map("name_pt")
  slug              String                    @unique
  force             ExerciseForce?
  level             ExerciseLevel?
  mechanic          ExerciseMechanic?
  equipment         Equipment?
  primaryMuscles    MuscleGroup[]             @map("primary_muscles")
  secondaryMuscles  MuscleGroup[]             @map("secondary_muscles")
  instructions      String[]
  instructionsPt    String[]                  @map("instructions_pt")
  imageUrls         String[]                  @map("image_urls")
  source            ExerciseSource            @default(SEED)
  createdByUserId   String?                   @map("created_by_user_id")
  createdBy         User?                     @relation(fields: [createdByUserId], references: [id])
  workoutExercises  WorkoutExercise[]
  templateExercises WorkoutTemplateExercise[]
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([source])
  @@map("exercises")
}

model Workout {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?           @map("template_id")
  template   WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startedAt  DateTime          @default(now()) @map("started_at")
  finishedAt DateTime?         @map("finished_at")
  notes      String?
  exercises  WorkoutExercise[]
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@index([userId, startedAt])
  @@index([templateId])
  @@map("workouts")
}

model WorkoutTemplate {
  id          String                    @id @default(cuid())
  userId      String
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  exercises   WorkoutTemplateExercise[]
  workouts    Workout[]
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("workout_templates")
}

model WorkoutTemplateExercise {
  id              String          @id @default(cuid())
  templateId      String          @map("template_id")
  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId      String          @map("exercise_id")
  exercise        Exercise        @relation(fields: [exerciseId], references: [id])
  order           Int
  targetSets      Int?            @map("target_sets")
  targetRepsMin   Int?            @map("target_reps_min")
  targetRepsMax   Int?            @map("target_reps_max")
  supersetGroupId String?         @map("superset_group_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([templateId])
  @@index([exerciseId])
  @@map("workout_template_exercises")
}

model WorkoutExercise {
  id              String       @id @default(cuid())
  workoutId       String       @map("workout_id")
  workout         Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId      String       @map("exercise_id")
  exercise        Exercise     @relation(fields: [exerciseId], references: [id])
  order           Int
  supersetGroupId String?      @map("superset_group_id")
  sets            WorkoutSet[]
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String          @map("workout_exercise_id")
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int             @map("set_number")
  weightKg          Decimal?        @map("weight_kg") @db.Decimal(6, 2)
  reps              Int?
  rpe               Decimal?        @db.Decimal(3, 1)
  setType           SetType         @default(WORKING) @map("set_type")
  completedAt       DateTime        @default(now()) @map("completed_at")
  // idempotency key sent by the iOS app on POST .../sets, so a manual resend
  // after a lost response can't duplicate the set; the web never sends it
  clientId          String?         @map("client_id")

  @@unique([workoutExerciseId, clientId])
  @@index([workoutExerciseId])
  @@map("workout_sets")
}

// ---- Diet module (food logging) ----

enum FoodSource {
  TACO
  OFF
  CUSTOM

  @@map("food_source")
}

// Closed vocabulary of meal *names*, not the day's slots — those live in the
// Meal table below, one row per slot the user configured. Two slots may share
// a type (two "Lanche"), which is exactly why FoodLog points at a Meal id
// instead of carrying this enum directly.
enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  SUPPER

  @@map("meal_type")
}

// One row per meal slot in the user's day, applying to every date (the
// structure is a per-user configuration, not per-day). `order` is always
// derived server-side from array position, never trusted from the client.
model Meal {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      MealType
  order     Int
  createdAt DateTime  @default(now()) @map("created_at")
  foodLogs  FoodLog[]

  @@index([userId, order])
  @@map("meals")
}

model Food {
  id              String          @id @default(cuid())
  name            String
  brand           String?
  source          FoodSource
  externalId      String?         @map("external_id")
  imageUrl        String?         @map("image_url")
  kcal            Float
  protein         Float
  carbs           Float
  fat             Float
  fiber           Float?
  sodium          Float?
  // household measure ("1 unidade", "1 fatia") when known — servingLabel is a
  // closed slug from serving-units.ts, translated on the client; servingGrams
  // is how many grams one of those weighs. Both null = grams-only food.
  // Never changes how nutrition is stored: every value above is still per 100g.
  servingLabel    String?         @map("serving_label")
  servingGrams    Float?          @map("serving_grams")
  createdByUserId String?         @map("created_by_user_id")
  createdBy       User?           @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  logs            FoodLog[]
  savedMealItems  SavedMealItem[]

  @@unique([source, externalId])
  @@index([name])
  @@map("foods")
}

model FoodLog {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId           String   @map("food_id")
  food             Food     @relation(fields: [foodId], references: [id])
  // always grams, whatever unit the user picked in the UI — every aggregation
  // (getDailySummary/getHistory) multiplies by quantity/100 and must stay that way
  quantity         Float
  // display hint only: true means the user entered this as N servings, so the
  // UI renders "2 unidades (100 g)" instead of "100 g". Never affects math.
  enteredAsServing Boolean  @default(false) @map("entered_as_serving")
  // deleting a meal deletes its logs across every day — deliberate, and the
  // opposite of Workout.templateId (SET NULL). The UI confirms with a count
  // before it happens; pinned by meals-migration.test.ts
  mealId           String   @map("meal_id")
  meal             Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  loggedAt         DateTime @map("logged_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, loggedAt])
  @@index([mealId])
  @@map("food_logs")
}

// A saved meal has no fixed Meal — it's just a named list of
// food+quantity, applied to whichever meal slot the user is in at the time
// (mirrors WorkoutTemplate having no fixed "day", applied to any Workout)
model SavedMeal {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     SavedMealItem[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@map("saved_meals")
}

model SavedMealItem {
  id          String    @id @default(cuid())
  savedMealId String    @map("saved_meal_id")
  savedMeal   SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodId      String    @map("food_id")
  food        Food      @relation(fields: [foodId], references: [id])
  quantity    Float
  order       Int
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([savedMealId])
  @@index([foodId])
  @@map("saved_meal_items")
}
