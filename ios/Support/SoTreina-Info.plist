<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- merged by xtool over its generated Info.plist -->
	<key>CFBundleDisplayName</key>
	<string>SoTreina</string>
	<!-- without this, Activity.request() throws and nothing shows up -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- the diet's barcode scanner (BarcodeScannerView); one language only:
	     InfoPlist.strings would have to live in the main bundle -->
	<key>NSCameraUsageDescription</key>
	<string>O SoTreina usa a câmera para ler o código de barras dos alimentos.</string>
	<!-- dev only in practice: the server sheet pointing at a backend on the
	     PC's LAN IP over plain http (README, "Testar contra a API local").
	     NSAllowsLocalNetworking lifts ATS only for local addresses, never
	     for the internet; iOS asks the Local Network permission with this text -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>O SoTreina acessa a rede local só quando aponta para um servidor de desenvolvimento.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- the Live Activity's buttons are sotreina:// links (ActivityLink):
	     intent buttons need AppIntents metadata xtool can't generate -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.feroleto.sotreina</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sotreina</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
