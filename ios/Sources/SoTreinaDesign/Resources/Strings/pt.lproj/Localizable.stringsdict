<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>gym.summary.prTitle %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@records@</string>
		<key>records</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Recorde pessoal</string>
			<key>other</key>
			<string>Recordes pessoais</string>
		</dict>
	</dict>
	<key>onboarding.areas.count %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@areas@</string>
		<key>areas</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld área selecionada</string>
			<key>other</key>
			<string>%lld áreas selecionadas</string>
		</dict>
	</dict>
	<key>gym.routines.exerciseCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@exercises@</string>
		<key>exercises</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld exercício</string>
			<key>other</key>
			<string>%lld exercícios</string>
		</dict>
	</dict>
	<key>gym.routines.savedCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rotina salva</string>
			<key>other</key>
			<string>%lld rotinas salvas</string>
		</dict>
	</dict>
	<key>gym.editor.exercisesAdded %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld exercício adicionado</string>
			<key>other</key>
			<string>%lld exercícios adicionados</string>
		</dict>
	</dict>
	<key>gym.editor.selected %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld selecionado</string>
			<key>other</key>
			<string>%lld selecionados</string>
		</dict>
	</dict>
	<key>gym.history.weeksCount %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld semana</string>
			<key>other</key>
			<string>%lld semanas</string>
		</dict>
	</dict>
	<key>gym.history.olderWeeks %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>+ %lld semana anterior</string>
			<key>other</key>
			<string>+ %lld semanas anteriores</string>
		</dict>
	</dict>
</dict>
</plist>
